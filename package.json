{
  "name": "dbg-algo",
  "private": true,
  "packageManager": "yarn@4.13.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:py": "python -m pytest",
    "test:integration": "yarn workspace dbga-extension test:integration",
    "test:e2e": "make -C tests/targets && node tests/run_extractors.mjs",
    "test:report": "node tools/report/test-report.mjs",
    "bench": "node tools/report/test-report.mjs --bench"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^22",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
