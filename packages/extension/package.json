{
  "name": "dbga-extension",
  "displayName": "DbgAlgo",
  "description": "Visualize data structures during debugging",
  "version": "0.1.0",
  "publisher": "henriquegoliveira",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Debuggers",
    "Visualization",
    "Education"
  ],
  "activationEvents": [
    "onDebug"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dbg-algo.start",
        "title": "DbgAlgo: Iniciar WebView",
        "category": "Visualização"
      }
    ],
    "configuration": {
      "title": "DbgAlgo",
      "properties": {
        "dbgAlgo.rootFilter": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "dbgAlgo.limits.maxNodes": {
          "type": "number",
          "minimum": 1,
          "default": 2000
        },
        "dbgAlgo.limits.maxEdges": {
          "type": "number",
          "minimum": 1,
          "default": 6000
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "dbg-algo.start",
          "when": "true"
        }
      ]
    }
  },
  "scripts": {
    "dev": "node esbuild.js --watch",
    "build": "tsc --noEmit && node esbuild.js",
    "typecheck": "tsc --noEmit",
    "gen:types": "json2ts schemas/graph-snapshot.schema.json -o src/graphSnapshot.ts --additionalProperties false --style.singleQuote --style.printWidth 100",
    "check:types": "yarn gen:types && git diff --exit-code src/graphSnapshot.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "express": "^5.2.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/vscode": "^1.95.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.27.4",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "~5.9.3"
  }
}
