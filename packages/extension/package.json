{
  "name": "debug-algo",
  "displayName": "DebugAlgo",
  "description": "Visualize data structures during debugging",
  "version": "0.1.0",
  "publisher": "henriquegoliveira",
  "preview": true,
  "license": "GPL-3.0-or-later",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/henriquegoliveira/vscode-debug-algo.git",
    "directory": "packages/extension"
  },
  "bugs": {
    "url": "https://github.com/henriquegoliveira/vscode-debug-algo/issues"
  },
  "homepage": "https://github.com/henriquegoliveira/vscode-debug-algo#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Debuggers",
    "Visualization",
    "Education"
  ],
  "keywords": [
    "c",
    "cpp",
    "data structures",
    "linked list",
    "binary tree",
    "graph",
    "pointers",
    "visualization",
    "gdb",
    "lldb",
    "algorithms",
    "education"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrustedWorkspaces.description%"
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onDebug"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "debug-algo.start",
        "title": "%command.start.title%",
        "category": "DebugAlgo"
      },
      {
        "command": "debug-algo.annotateArray",
        "title": "%command.annotateArray.title%",
        "category": "DebugAlgo",
        "icon": "$(symbol-array)"
      },
      {
        "command": "debug-algo.startServer",
        "title": "%command.startServer.title%",
        "category": "DebugAlgo"
      }
    ],
    "configuration": {
      "title": "DebugAlgo",
      "properties": {
        "debugAlgo.dynamicArrays": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%config.dynamicArrays.markdownDescription%"
        },
        "debugAlgo.rootFilter": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%config.rootFilter.markdownDescription%"
        },
        "debugAlgo.limits.maxNodes": {
          "type": "number",
          "minimum": 1,
          "default": 2000,
          "markdownDescription": "%config.limits.maxNodes.markdownDescription%"
        },
        "debugAlgo.limits.maxEdges": {
          "type": "number",
          "minimum": 1,
          "default": 6000,
          "markdownDescription": "%config.limits.maxEdges.markdownDescription%"
        },
        "debugAlgo.limits.maxCells": {
          "type": "number",
          "minimum": 1,
          "default": 64,
          "markdownDescription": "%config.limits.maxCells.markdownDescription%"
        },
        "debugAlgo.limits.historyDepth": {
          "type": "number",
          "minimum": 1,
          "default": 20,
          "markdownDescription": "%config.limits.historyDepth.markdownDescription%"
        },
        "debugAlgo.view": {
          "type": "object",
          "scope": "resource",
          "default": {},
          "markdownDescription": "%config.view.markdownDescription%"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "debug-algo.start",
          "when": "true"
        },
        {
          "command": "debug-algo.annotateArray",
          "when": "true"
        },
        {
          "command": "debug-algo.startServer",
          "when": "true"
        }
      ],
      "editor/title": [
        {
          "command": "debug-algo.annotateArray",
          "when": "activeWebviewPanelId == debugAlgoWebview",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "dev": "node esbuild.js --watch",
    "build": "tsc --noEmit && node esbuild.js",
    "typecheck": "tsc --noEmit",
    "gen:types": "json2ts schemas/graph-snapshot.schema.json -o ../contract/src/graphSnapshot.ts --additionalProperties false --style.singleQuote --style.printWidth 100",
    "check:types": "yarn gen:types && git diff --exit-code ../contract/src/graphSnapshot.ts",
    "test:integration": "yarn workspace dbga-webview build && node esbuild.js && tsc --noEmit -p test/integration && node esbuild.js --tests && vscode-test",
    "l10n:export": "npx --yes @vscode/l10n-dev@0.0.35 export --outDir ./l10n ./src ../webview/src"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "dbga-contract": "workspace:^",
    "express": "^5.2.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/mocha": "^10",
    "@types/node": "^20",
    "@types/vscode": "^1.95.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.27.4",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "~5.9.3"
  }
}
