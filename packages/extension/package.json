{
  "name": "dbg-algo-extension",
  "displayName": "DbgAlgo",
  "description": "Visualize data structures during debugging",
  "version": "0.1.0",
  "publisher": "henriquegoliveira",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers",
    "Visualization",
    "Education"
  ],
  "activationEvents": [
    "onCommand",
    "onDebug"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dbg-algo.start",
        "title": "DbgAlgo: Iniciar WebView",
        "category": "Visualização"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "dbg-algo.start",
          "when": "true"
        }
      ]
    }
  },
  "scripts": {
    "dev": "node esbuild.js --watch",
    "build": "node esbuild.js"
  },
  "packageManager": "yarn@4.13.0",
  "typecheck": "tsc --noEmit",
  "dependencies": {
    "express": "^5.2.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/vscode": "^1.110.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.27.4"
  }
}
